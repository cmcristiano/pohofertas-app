# Environment Variables for PohOfertas Admin
# Copy this file to .env.local and fill in the values

# GitHub API
GITHUB_TOKEN=your_github_personal_access_token_here

# Admin Dashboard
ADMIN_TOKEN=your_secure_admin_token_here
NEXT_PUBLIC_ADMIN_TOKEN=your_secure_admin_token_here
NEXT_PUBLIC_ADMIN_PASSWORD=your_admin_dashboard_password_here

# Instructions:
# 1. GITHUB_TOKEN: Personal access token from https://github.com/settings/tokens
#    Permissions needed: repo (full control)
# 2. ADMIN_TOKEN: Any secure string to protect your API (same for both)
# 3. ADMIN_PASSWORD: Password to access the admin dashboard at /admin
